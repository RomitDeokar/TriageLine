# TriageLine configuration. Copy to .env (gateway + docker compose) and/or livekit_agent/.env.local
# (worker run from source). Never commit real values. Free sign-up steps: docs/FREE_API_KEYS.md

# ---------------------------------------------------------------- LiveKit (voice calls)
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Explicit dispatch: only the worker with this name joins rooms minted by /api/rtc/token.
# Leave EMPTY for the official FDB-v3 benchmark runner (it relies on automatic dispatch).
TRIAGELINE_AGENT_NAME=
# Worker behaviour: benchmark (FDB-v3 template: never asks, fast commit) | assistant (asks + confirms)
TRIAGELINE_MODE=benchmark

# ---------------------------------------------------------------- LLM planner (free-tier chain)
# One key is enough. Gemini (AI Studio) also powers STT/TTS. Order = failover order.
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# TRIAGELINE_LLM_CHAIN=gemini,cerebras,openrouter,mistral
# TRIAGELINE_LLM_PLANNER=auto          # auto (on when a key exists) | 1 | 0 (rules only)
# TRIAGELINE_LLM_MODEL_GEMINI=gemini-3.5-flash-lite
# Self-hosted OpenAI-compatible server (Ollama/vLLM):
# TRIAGELINE_LLM_BASE_URL=http://localhost:11434/v1
# TRIAGELINE_LLM_API_KEY=ollama
# TRIAGELINE_LLM_MODEL_CUSTOM=llama3.1

# ---------------------------------------------------------------- Speech (LiveKit worker)
TRIAGELINE_STT_PROVIDER=auto           # auto | gemini | deepgram | openai | groq
TRIAGELINE_TTS_PROVIDER=auto           # auto | gemini | deepgram | openai
# TRIAGELINE_STT_MODEL=gemini-3.5-flash-lite
# TRIAGELINE_TTS_MODEL=gemini-3.8-flash-lite-tts
# TRIAGELINE_TTS_VOICE=Kore
# Deepgram gives genuinely streaming STT/TTS (lowest latency); free credit on sign-up.
DEEPGRAM_API_KEY=
# OpenAI: optional speech provider; REQUIRED only for the official gpt-4o LLM judge (paid).
OPENAI_API_KEY=

# ---------------------------------------------------------------- Gateway (ui/api.py)
TRIAGELINE_ENV=development             # production enforces the three settings below
TRIAGELINE_ACCESS_CODE=                # 16+ chars in production; share with pilot users only
TRIAGELINE_SESSION_SECRET=             # 32+ random chars: python -c "import secrets;print(secrets.token_hex(32))"
ALLOWED_HOSTS=localhost,127.0.0.1      # your public hostname(s) in production
# CORS_ORIGINS=https://app.example.com
# TRIAGELINE_API_KEY=                  # 32+ chars; enables backend-to-backend POST /api/mobile/token
# TRIAGELINE_RTC_TOKEN_TTL_S=600
# TRIAGELINE_MAX_SESSIONS=8
# PRELOAD=1                            # warm local ASR/CLIP at startup
