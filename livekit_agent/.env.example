# Worker-only settings when running livekit_agent/cascaded_agent.py from source, AND the file
# ./run_fdb_v3.sh reads (it also reads a repo-root .env; this file wins).
#
# FOR THE SCORED FDB-v3 RE-RUN YOU NEED EXACTLY:
#   LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET   (a LiveKit Cloud project, free Build plan)
#   DEEPGRAM_API_KEY  or  GEMINI_API_KEY                 (speech: Deepgram preferred - streaming, lower latency)
#   OPENAI_API_KEY                                       (the official gpt-4o judge only)
# Nothing else. The LLM planner is pinned OFF by run_fdb_v3.sh (rules-only, deterministic).
# The full, documented list lives in the repository root .env.example — copy the keys you need
# to livekit_agent/.env.local (never commit it).
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GEMINI_API_KEY=
TRIAGELINE_STT_PROVIDER=auto
TRIAGELINE_TTS_PROVIDER=auto
# TRIAGELINE_MODE=assistant            # default benchmark (for ./run_fdb_v3.sh)
# TRIAGELINE_AGENT_NAME=triageline-assistant   # leave EMPTY for run_fdb_v3.sh (automatic dispatch)
#                                              # triage worker: TRIAGELINE_AGENT_NAME=triageline-triage
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
