# Copy to livekit_agent/.env.local (NOT .env) and fill in. Never commit .env.local.
# Free sign-up steps for every key: docs/FREE_API_KEYS.md

# LiveKit Cloud project (free Build plan) — Settings -> API Keys at https://cloud.livekit.io
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# One Gemini Developer API key for STT, planner and TTS (no Google Cloud ADC needed).
# Get a key at https://aistudio.google.com/apikey ; quota/model access still applies.
TRIAGELINE_STT_PROVIDER=auto
TRIAGELINE_TTS_PROVIDER=auto
GEMINI_API_KEY=
TRIAGELINE_LLM_PROVIDER=gemini
TRIAGELINE_LLM_PLANNER=auto
# TRIAGELINE_STT_MODEL=gemini-2.5-flash
# TRIAGELINE_TTS_MODEL=gemini-2.5-flash-preview-tts
# TRIAGELINE_TTS_VOICE=Kore
# TRIAGELINE_LLM_MODEL=gemini-2.5-flash
# Set TRIAGELINE_LLM_PLANNER=0 for strictly local rule-based tool planning.
# Alternative speech: STT=groq/deepgram/openai; TTS=deepgram/openai (Groq has no supported TTS here).
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# Optional: OpenAI for STT/TTS, and REQUIRED only for the official gpt-4o LLM judge (paid)
OPENAI_API_KEY=
# OPENAI_BASE_URL=
