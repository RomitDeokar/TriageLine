# Worker-only settings when running livekit_agent/cascaded_agent.py from source.
# The full, documented list lives in the repository root .env.example — copy the keys you need
# to livekit_agent/.env.local (never commit it).
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GEMINI_API_KEY=
TRIAGELINE_STT_PROVIDER=auto
TRIAGELINE_TTS_PROVIDER=auto
# TRIAGELINE_MODE=assistant            # default benchmark (for ./run_fdb_v3.sh)
# TRIAGELINE_AGENT_NAME=triageline-assistant
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
