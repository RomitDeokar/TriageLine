# Copy to livekit_agent/.env.local (NOT .env) and fill in. Never commit .env.local.
# cascaded_agent.py and livekit_inference.py both load ".env.local".

# LiveKit Cloud project (Project Settings -> Keys at https://cloud.livekit.io)
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cascaded template uses OpenAI for all three: Whisper STT + gpt-4o LLM + tts-1 TTS
OPENAI_API_KEY=
