# Copy to livekit_agent/.env.local (NOT .env) and fill in. Never commit .env.local.
# Free sign-up steps for every key: docs/FREE_API_KEYS.md

# LiveKit Cloud project (free Build plan) — Settings -> API Keys at https://cloud.livekit.io
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech providers (no LLM is used by the agent). openai | groq | deepgram (TTS: openai | deepgram)
TRIAGELINE_STT_PROVIDER=groq
TRIAGELINE_TTS_PROVIDER=deepgram
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# Optional: OpenAI for STT/TTS, and REQUIRED only for the official gpt-4o LLM judge (paid)
OPENAI_API_KEY=
# OPENAI_BASE_URL=
